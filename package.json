{
  "name": "mc-mapper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "wrangler pages dev dist --d1 DB=mc-mapper",
    "wasm": "./scripts/build-wasm.sh",
    "db:local": "wrangler d1 migrations apply mc-mapper --local",
    "db:remote": "wrangler d1 migrations apply mc-mapper --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
